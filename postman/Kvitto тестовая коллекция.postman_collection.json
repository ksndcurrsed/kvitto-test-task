    {
      "name": "7. Вебхук",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.environment.get(\"webhook_secret\");\r\nconst body = pm.request.body.raw;\r\n\r\nconst signature = CryptoJS\r\n    .HmacSHA256(body, secret)\r\n    .toString(CryptoJS.enc.Hex);\r\n\r\npm.request.headers.upsert({\r\n    key: \"X-Signature\",\r\n    value: signature\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
